#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 600  /* 600 */
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20   /*  10 */
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };

      td_lctl: tap_dance_lctrl_tog4 {
          compatible = "zmk,behavior-tap-dance";
          label = "LEFT_CONTROL_TOGGLE_LAYER_4";
          #binding-cells = <0>;
          tapping-term-ms = <200>;
          bindings = <&kp LCTRL>, <&tog 4>, <&tog 9>;
      };

      td_rctl: tap_dance_rctrl_tog5 {
          compatible = "zmk,behavior-tap-dance";
          label = "RIGHT_CONTROL_TOGGLE_LAYER_5";
          #binding-cells = <0>;
          tapping-term-ms = <200>;
          bindings = <&kp LCTRL>, <&tog 5>;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    /* layer 0 */
    default_layer {
      display-name = "Base";
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &tog 1                                                           &mo 3 &kp N6 &kp N7 &kp N8    &kp N9   &kp N0   &kp MINUS
        &kp TAB   &hm RGUI APOS &hm RALT COMMA &hm RCTRL DOT &hm LALT P &hm LCTRL Y &none                                  &none &hm LCTRL F  &hm LALT G &hm RCTRL C &hm RALT R  &hm RGUI L &kp SLASH
        &kp ESC   &hm LGUI A &hm LSHFT O &hm LALT E &hm LCTRL U &kp I  &none    &td_lctl  &kp LALT &kp LALT  &td_rctl            &none &kp D  &hm LCTRL H &hm LALT T &hm LSHFT N &hm LGUI S &kp BSLH
        &kp LSHFT &kp SEMI  &kp Q    &kp J    &kp K      &kp X                       &mt LGUI HOME &mt LGUI PG_UP                      &kp B  &kp M  &kp W     &kp V    &kp Z    &kp RSHFT
        &mo 2     &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT                &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp SPACE              &kp UP &kp DOWN  &kp LBKT &kp RBKT &mo 2
      >;
    };
    /* layer 1 */
    keypad {
      display-name = "Kp";
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &trans                                                           &mo 3 &kp N6 &kp KP_NUM &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &none                                                            &none &kp Y  &kp KP_N7  &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &kp BSLH
        &kp ESC   &kp A     &kp S    &kp D    &kp F      &kp G  &none           &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL           &none &kp H  &kp KP_N4  &kp KP_N5    &kp KP_N6     &kp KP_PLUS     &kp SQT
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                            &kp HOME &kp PG_UP                           &kp N  &kp KP_N1  &kp KP_N2    &kp KP_N3     &kp KP_ENTER    &kp RSHFT
        &mo 2     &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT                &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp KP_N0              &kp UP     &kp DOWN     &kp KP_DOT    &kp RBKT        &mo 2
      >;
    };
    /* layer 2 */
    fn {
      display-name = "Fn";
      bindings = <
        &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &tog 1                                           &mo 3 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
        &trans &trans &trans &trans &trans &trans  &none                                           &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans  &none        &trans &trans &trans &trans        &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans                      &trans &trans                     &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans              &trans &trans &trans  &trans  &trans
      >;
    };
    /* layer 3 */
    mod {
      display-name = "Mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &stp STP_BAT &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };
    extra1 { 
      display-name = "Red";    
      status = "reserved";
    };

    extra2 { 
      display-name = "Purple";    
      status = "reserved";
    };

    extra3 { 
      display-name = "Cyan";    
      status = "reserved";
    };

    extra4 { 
      display-name = "Yellow";    
      status = "reserved";
    };
    /* layer 4 */
    dverok_layer {
      display-name = "Dvorak";
      bindings = <
        &kp EQUAL &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &tog 1                                                                   &mo 3 &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS
        &kp TAB   &kp APOS  &kp COMMA &kp DOT   &kp P     &kp Y     &none                                                                    &none &kp F     &kp G     &kp C     &kp R     &kp L     &kp SLASH
        &kp ESC   &kp A     &kp O     &kp E     &kp U     &kp I     &none                 &td_lctl  &kp LALT      &kp LALT  &td_rctl         &none &kp D     &kp H     &kp T     &kp N     &kp S     &kp BSLH
        &kp LSHFT &kp SEMI  &kp Q     &kp J     &kp K     &kp X                                     &mt LGUI HOME &mt LGUI PG_UP                   &kp B     &kp M     &kp W     &kp V     &kp Z     &kp RSHFT
        &mo 2     &kp GRAVE &kp CAPS  &kp LEFT  &kp RIGHT                       &kp BSPC  &kp DEL   &kp END       &kp PG_DN &kp ENTER &kp SPACE              &kp UP    &kp DOWN  &kp LBKT  &kp RBKT  &mo 2
      >;
    };
    /* layer 5 */
    mouse_layer {
      display-name = "Mouse";
      bindings = <
        &trans    &trans    &kp LG(V) &kp LG(C) &trans    &trans    &tog 1                                                                   &mo 3 &trans    &trans    &kp LG(C) &kp LG(V)  &trans    &trans
        &trans    &mo 6     &msc SCRL_DOWN &mmv MOVE_UP &msc SCRL_UP &mo 7 &none                                                             &none &mo 7     &msc SCRL_UP &mmv MOVE_UP &msc SCRL_DOWN &mo 6 &trans
        &trans    &msc SCRL_LEFT &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &msc SCRL_RIGHT &none &td_lctl &trans &trans &td_rctl         &none &msc SCRL_LEFT &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &msc SCRL_RIGHT &trans
        &trans    &kp LGUI  &kp LSHFT &kp LALT  &kp LCTRL &trans                                    &trans        &trans                           &trans    &kp LCTRL &kp LALT  &kp LSHFT &kp LGUI  &trans
        &mo 2     &mo 8     &trans    &trans    &trans                          &mkp LCLK &mkp RCLK &trans        &trans &mkp RCLK &mkp LCLK                 &trans    &trans    &trans    &trans    &mo 2
      >;
    };
    /* layer 6 */
    mouse_low_layer {
      display-name = "Mouse LOW";
      bindings = <
        &trans    &trans    &trans    &trans    &trans    &trans    &tog 1                                                                   &mo 3 &trans    &trans    &trans    &trans    &trans    &trans
        &trans    &trans    &trans    &trans    &trans    &trans    &none                                                                    &none &trans    &trans    &trans    &trans    &trans    &trans
        &trans    &trans    &trans    &trans    &trans    &trans    &none                 &td_lctl  &trans        &trans &td_rctl            &none &trans    &trans    &trans    &trans    &trans    &trans
        &trans    &trans    &trans    &trans    &trans    &trans                                    &trans        &trans                           &trans    &trans    &trans    &trans    &trans    &trans
        &mo 2     &mo 8     &trans    &trans    &trans                          &trans    &trans    &trans        &trans &trans    &trans                    &trans    &trans    &trans    &trans    &mo 2
      >;
    };
    /* layer 7 */
    mouse_high_layer {
      display-name = "Mouse HIGH";
      bindings = <
        &trans    &trans    &trans    &trans    &trans    &trans    &tog 1                                                                   &mo 3 &trans    &trans    &trans    &trans    &trans    &trans
        &trans    &trans    &trans    &trans    &trans    &trans    &none                                                                    &none &trans    &trans    &trans    &trans    &trans    &trans
        &trans    &trans    &trans    &trans    &trans    &trans    &none                 &td_lctl  &trans        &trans &td_rctl            &none &trans    &trans    &trans    &trans    &trans    &trans
        &trans    &trans    &trans    &trans    &trans    &trans                                    &trans        &trans                           &trans    &trans    &trans    &trans    &trans    &trans
        &mo 2     &mo 8     &trans    &trans    &trans                          &trans    &trans    &trans        &trans &trans    &trans                    &trans    &trans    &trans    &trans    &mo 2
      >;
    };
    /* layer 8 */
    scroll_layer {
      display-name = "Mouse Scroll";
      bindings = <
        &trans    &trans    &trans    &trans    &trans    &trans    &tog 1                                                                   &mo 3 &trans    &trans    &trans    &trans    &trans    &trans
        &trans    &trans    &trans    &msc SCRL_UP &trans &trans    &none                                                                    &none &trans    &trans    &msc SCRL_UP &trans &trans  &trans
        &trans    &trans    &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_RIGHT &trans &none    &td_lctl  &trans        &trans &td_rctl            &none &trans    &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_RIGHT &trans &trans
        &trans    &trans    &trans    &trans    &trans    &trans                                    &trans        &trans                           &trans    &trans    &trans    &trans    &trans    &trans
        &mo 2     &mo 8     &trans    &trans    &trans                          &trans    &trans    &trans        &trans &trans    &trans                    &trans    &trans    &trans    &trans    &mo 2
      >;
    };
    /* layer 9 */
    qwerty_layer {
      display-name = "Qwerty";
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &tog 1                                                           &mo 3 &kp N6 &kp N7 &kp N8    &kp N9   &kp N0   &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &none                                                            &none &kp Y  &kp U  &kp I     &kp O    &kp P    &kp BSLH
        &kp ESC   &kp A     &kp S    &kp D    &kp F      &kp G  &none           &td_lctl  &kp LALT &kp LALT  &td_rctl            &none &kp H  &kp J  &kp K     &kp L    &kp SEMI &kp APOS
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                       &mt LGUI HOME &mt LGUI PG_UP                      &kp N  &kp M  &kp COMMA &kp DOT  &kp SLASH &kp RSHFT
        &mo 2     &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT                &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp SPACE              &kp UP &kp DOWN  &kp LBKT &kp RBKT &mo 2
      >;
    };
  };
};

&mmv_input_listener {
  mouse_low {
    layers = <6>;
    input-processors = <&zip_xy_scaler 1 3>;
  };

  mouse_high {
    layers = <7>;
    input-processors = <&zip_xy_scaler 2 1>;
  };
};

&msc_input_listener {
  input-processors = <&zip_scroll_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>;
};